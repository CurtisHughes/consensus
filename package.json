{
  "name": "consensus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:dev": "vue-tsc --build && vite build --mode development",
    "preview": "vite preview --port 4173",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "vite build && start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:open": "start-server-and-test 'vite --port 4173' http://localhost:4173 'cypress open --e2e'",
    "lint": "eslint . --fix --cache",
    "lint:check": "eslint .",
    "format": "prettier --write src/ cypress/ tests/",
    "format:check": "prettier --check src/ cypress/ tests/",
    "deploy": "npm run build && firebase deploy",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-vue": "^10.12.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "simple-git-hooks": "^2.14.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "cypress": true,
    "google-logging-utils": false,
    "protobufjs": false,
    "re2": false,
    "simple-git-hooks": false,
    "@firebase/util": false,
    "@parcel/watcher": false
  }
}
