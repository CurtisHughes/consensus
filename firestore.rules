rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPoll(data) {
      return data.keys().hasOnly(['name', 'description', 'author'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.author == request.auth.uid;
    }

    function isValidResponse(data) {
      return data.keys().hasOnly(['author', 'value'])
        && data.author == request.auth.uid
        && data.value is map
        && data.value.keys().hasOnly(['year', 'month', 'day'])
        && data.value.year is int && data.value.year >= 2000 && data.value.year <= 2200
        && data.value.month is int && data.value.month >= 0 && data.value.month <= 11
        && data.value.day is int && data.value.day >= 1 && data.value.day <= 31;
    }

    function isValidParticipant(data) {
      return data.keys().hasOnly(['name'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50;
    }

    // One response per author per date, so a repeated create becomes a (denied) update.
    function responseId(data) {
      return data.author + '_' + string(data.value.year) + '-' + string(data.value.month) + '-'
        + string(data.value.day);
    }

    function pollExists(poll) {
      return exists(/databases/$(database)/documents/polls/$(poll));
    }

    // Polls can be read by id but never listed, and are immutable once created.
    match /polls/{poll} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isValidPoll(request.resource.data);
      allow update, delete: if false;
    }

    // Responses can be created by their author, and deleted by their author. They are never edited.
    match /polls/{poll}/responses/{response} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidResponse(request.resource.data)
        && response == responseId(request.resource.data)
        && pollExists(poll);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.author == request.auth.uid;
    }

    // Each user can set and rename their own display name for a poll, keyed by their uid.
    match /polls/{poll}/participants/{participant} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && participant == request.auth.uid
        && isValidParticipant(request.resource.data)
        && pollExists(poll);
      allow update: if isSignedIn()
        && participant == request.auth.uid
        && isValidParticipant(request.resource.data);
      allow delete: if false;
    }
  }
}
